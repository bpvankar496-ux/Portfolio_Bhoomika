<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= data.name %> | Portfolio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- ===== Navbar ===== -->
  <nav class="navbar" id="navbar">
    <div class="nav-logo"><%= data.name.split(' ')[0] %><span> Vankar</span></div>
    <div class="nav-links" id="navLinks">
      <a href="#home">Home</a>
      <a href="#about">About</a>
      <a href="#skills">Skills</a>
      <a href="#projects">Projects</a>
      <a href="#contact">Contact</a>
    </div>
    <button class="nav-toggle" id="navToggle">
      <i class="fa-solid fa-bars"></i>
    </button>
  </nav>

  <!-- ===== Hero Section ===== -->
  <section class="hero" id="home">
    <div class="hero-content">
      <p class="hero-greeting">👋 Hello, I'm</p>
      <h1 class="hero-name"><%= data.name %></h1>
      <h2 class="hero-title"><%= data.title %></h2>
      <p class="hero-desc"><%= data.about %></p>
      <div class="hero-buttons">
        <a href="#projects" class="btn-primary">View My Work</a>
        <a href="#contact" class="btn-secondary">Hire Me</a>
      </div>
      <div class="hero-socials">
        <a href="<%= data.github %>" target="_blank"><i class="fa-brands fa-github"></i></a>
        <a href="<%= data.linkedin %>" target="_blank"><i class="fa-brands fa-linkedin"></i></a>
        <a href="mailto:<%= data.email %>"><i class="fa-solid fa-envelope"></i></a>
      </div>
    </div>
    <div class="hero-image">
  <div class="hero-blob">
    <img src="/images/photo.jpeg" alt="<%= data.name %>">
  </div>
</div>
    </div>
  </section>

  <!-- ===== About Section ===== -->
  <section class="about-section section" id="about">
    <h2 class="section-title">About <span>Me</span></h2>
    <div class="about-grid">
      <div class="about-text fade-in">
        <p><%= data.about %></p>
        <div class="about-info">
          <div class="info-item">
            <i class="fa-solid fa-location-dot"></i>
            <span><%= data.location %></span>
          </div>
          <div class="info-item">
            <i class="fa-solid fa-envelope"></i>
            <span><%= data.email %></span>
          </div>
          <div class="info-item">
            <i class="fa-solid fa-phone"></i>
            <span><%= data.phone %></span>
          </div>
        </div>
        <a href="/Resume.pdf" download class="btn-primary" style="display:inline-flex; margin-top:20px;">
          <i class="fa-solid fa-download"></i> Download Resume
        </a>
      </div>
      <div class="about-stats fade-in">
        <div class="stat-card">
          <span class="stat-num">10+</span>
          <span class="stat-label">Projects Built</span>
        </div>
        <div class="stat-card">
          <span class="stat-num">4+</span>
          <span class="stat-label">Tech Stacks</span>
        </div>
        <div class="stat-card">
          <span class="stat-num">100%</span>
          <span class="stat-label">Passion</span>
        </div>
        <div class="stat-card">
          <span class="stat-num">∞</span>
          <span class="stat-label">Learning</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Skills Section ===== -->
  <section class="skills-section section" id="skills">
    <h2 class="section-title">My <span>Skills</span></h2>
    <div class="skills-grid">
      <% data.skills.forEach(skillGroup => { %>
        <div class="skill-card fade-in">
          <h3><%= skillGroup.category %></h3>
          <div class="skill-tags">
            <% skillGroup.items.forEach(skill => { %>
              <span class="skill-tag"><%= skill %></span>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <!-- ===== Projects Section ===== -->
  <section class="projects-section section" id="projects">
    <h2 class="section-title">My <span>Projects</span></h2>
    <div class="projects-grid">
      <% data.projects.forEach(project => { %>
        <div class="project-card fade-in <%= project.featured ? 'featured' : '' %>">
          <% if (project.featured) { %>
            <span class="featured-badge"><i class="fa-solid fa-star"></i> Featured</span>
          <% } %>
          <h3><%= project.title %></h3>
          <p><%= project.description %></p>
          <div class="project-tech">
            <% project.tech.forEach(t => { %>
              <span class="tech-tag"><%= t %></span>
            <% }) %>
          </div>
          <div class="project-links">
            <a href="<%= project.github %>" target="_blank" class="project-link">
              <i class="fa-brands fa-github"></i> Code
            </a>
            <% if (project.live) { %>
              <a href="<%= project.live %>" target="_blank" class="project-link live">
                <i class="fa-solid fa-arrow-up-right-from-square"></i> Live Demo
              </a>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <!-- ===== Contact Section ===== -->
  <section class="contact-section section" id="contact">
    <h2 class="section-title">Get In <span>Touch</span></h2>
    <div class="contact-grid">
      <div class="contact-info fade-in">
        <h3>Let's work together!</h3>
        <p>Have a project in mind? Looking for a developer? Or just want to say hi? My inbox is always open!</p>
        <div class="contact-details">
          <a href="mailto:<%= data.email %>" class="contact-detail-item">
            <i class="fa-solid fa-envelope"></i>
            <span><%= data.email %></span>
          </a>
          <a href="<%= data.github %>" target="_blank" class="contact-detail-item">
            <i class="fa-brands fa-github"></i>
            <span>GitHub Profile</span>
          </a>
          <a href="<%= data.linkedin %>" target="_blank" class="contact-detail-item">
            <i class="fa-brands fa-linkedin"></i>
            <span>LinkedIn Profile</span>
          </a>
        </div>
      </div>
      <div class="contact-form fade-in">
        <form id="contactForm">
          <input type="text" id="contactName" placeholder="Your Name" required>
          <input type="email" id="contactEmail" placeholder="Your Email" required>
          <textarea id="contactMessage" placeholder="Your Message" rows="5" required></textarea>
          <button type="submit" class="btn-primary">
            <i class="fa-solid fa-paper-plane"></i> Send Message
          </button>
          <p class="form-status" id="formStatus"></p>
        </form>
      </div>
    </div>
  </section>

  <!-- ===== Footer ===== -->
  <footer class="footer">
    <p>Designed & Built by <span><%= data.name %></span></p>
    <p class="footer-sub">© 2026 All rights reserved.</p>
  </footer>

  <script src="/js/script.js"></script>
</body>
</html>



